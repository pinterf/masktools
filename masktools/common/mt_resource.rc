#include <windows.h>
#include "mt_resource.h"

/////////////////////////////////////////////////////////////////////////////
// English resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,3,0,0
 PRODUCTVERSION 2,3,0,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            VALUE "Comments", "Mask creation and LUT filters for AviSynth"
            VALUE "FileDescription", "MaskTools2 for AviSynth"
            VALUE "FileVersion", "2.3"
            VALUE "InternalName", "masktools2"
            // Keep this file ASCII: llvm-rc and windres ignore the code page pragma, so
            // non-ASCII characters are written as wide-string escapes (\x00E9 = e acute).
            VALUE "LegalCopyright", L"Copyright (C) 2005-2013 Mathieu Monnier (Manao), 2013 Victor Efimov (tp7), 2017-2026 Ferenc Pint\x00E9r"
            VALUE "OriginalFilename", "masktools2.dll"
            VALUE "ProductName", "MaskTools2"
            VALUE "ProductVersion", "2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1200
    END
END

#endif    // English resources
/////////////////////////////////////////////////////////////////////////////
